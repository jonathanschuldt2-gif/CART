# ---- Local development only ----
# Leave DATABASE_URL unset to use a local SQLite file automatically.
# On Render, this is set for you via render.yaml (fromDatabase) — don't set
# it manually there.
# DATABASE_URL=postgresql://user:pass@localhost:5432/reseller_os

# Random long string used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# On Render, render.yaml generates this for you automatically.
SESSION_SECRET=change-this-to-a-random-string

# Set to "false" once everyone who needs an account has signed up, to close
# the /register page to new sign-ups. Existing accounts can still log in.
ALLOW_REGISTRATION=true

# Set to "production" to force Secure session cookies outside of Render
# (e.g. on another host that doesn't set the RENDER env var automatically).
# ENVIRONMENT=production

# ---- Local server ----
HOST=0.0.0.0
PORT=8000
